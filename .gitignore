# Python bytecode and caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover

# Packaging and build residue
build/
**/build/
*.egg-info/
**/*.egg-info/
.eggs/
**/.eggs/
*.egg
pip-wheel-metadata/
wheelhouse/
site/
*.spec

# Virtual environments and local Python state
.venv/
venv/
env/
ENV/
.python-version
.python_history
.ipython/
.jupyter/
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*.ipynb

# Editors and operating-system debris
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

